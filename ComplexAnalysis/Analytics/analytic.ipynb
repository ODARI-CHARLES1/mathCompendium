   "source": [
    "import sympy as sp\n",
    "from sympy import limit ,I,pi,exp\n",
    "z=sp.Symbol(\"z\",complex=True)"
   ]
  },
  {
   "attachments": {
    "a864461d-f6e3-440e-8654-5de859560212.png": {
     "image/png": ""
    }
   },
   "cell_type": "markdown",
   "id": "6a8c7835-3702-4a2e-9456-521055d402dc",
   "metadata": {},
   "source": [
    "\n",
    "# Computing limit of a Complex Function\n",
    "![image.png](attachment:a864461d-f6e3-440e-8654-5de859560212.png)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "5530e2e0-2739-43bb-bc03-1c728c6707c4",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/latex": [
       "$\\displaystyle \\frac{z^{2} - 4 z + 5}{z^{3} - z - 10 i}$"
      ],
      "text/plain": [
       "(z**2 - 4*z + 5)/(z**3 - z - 10*I)"
      ]
     },
     "execution_count": 10,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "f=(z**2-4*z+5)/(z**3-z-10*I)\n",
    "f"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "e85dab7f-fcfa-44c7-9d8a-f747a595d6d7",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/latex": [
       "$\\displaystyle \\frac{i \\left(8 - 12 i\\right)}{104}$"
      ],
      "text/plain": [
       "I*(8 - 12*I)/104"
      ]
     },
     "execution_count": 13,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "lim=limit(f,z,(2+I))\n",
    "lim"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "f7db7ce8-0c1e-4314-b944-f8ea209a55b6",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/latex": [
       "$\\displaystyle \\frac{3}{26} + \\frac{i}{13}$"
      ],
      "text/plain": [
       "3/26 + I/13"
      ]
     },
     "execution_count": 14,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "sp.simplify(lim)"
   ]
  },
